{
  "name": "jc-erp-backend",
  "version": "1.0.0",
  "description": "Backend for Junior College ERP prototype",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsnd --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "tunnel": "lt --port 5000",
    "seed": "ts-node src/scripts/seed.ts",
    "reset:demo-data": "ts-node src/scripts/reset.ts",
    "hash-passwords": "ts-node src/scripts/hashSeedPasswords.ts"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.13.2",
    "localtunnel": "^2.0.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~6.0.2"
  }
}

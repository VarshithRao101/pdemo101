# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# Environment files
.env
.env.*
*.env*
*.local

# ...except the template, which is the point of having one.
#
# `*.env*` above matched .env.example too, so the file documenting which
# variables the app needs was never committed — and the gap showed: OPS_PASSWORD_HASH
# was live on the server and absent from the template, so a deployment built
# from it had wipe, purge and restore silently unavailable.
#
# This file must never hold a real value. It currently carries only a database
# name, a token lifetime and the public origins; every secret is blank.
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backend Server
/server/node_modules
/server/.env
/server/dist
/server/credential-secrets.local.json

# Runtime backups (generated at runtime, never commit)
/server/backups/

# Dev artifacts
scratch/
tmp/
PHASE*.md
DEBUG_REPORT.md
DATABASE_MIGRATION_REPORT.md
DATABASE_ROOT_CAUSE_REPORT.md

.vercel
scratch/pdf-design-preview.html

# Credential handouts written by scripts/rotateCredentials.cjs.
# These hold the ONLY plaintext copy of the portal passwords and PINs, for
# just long enough to distribute them. Ignored here as a backstop; the real
# protection is deleting the file once the credentials are handed over.
credentials/
*.credentials.txt

# OpenWA / WhatsApp session experiments.
#
# Session folders hold an authenticated WhatsApp login — anyone with the
# folder can send as that number, so it must never reach a public repo. The
# exported API collections are large and local to whoever was experimenting.
_IGNORE_session/
open-wa-session.*
*.wa-session/
.wwebjs_auth/
.wwebjs_cache/
tokens/
session.data.json

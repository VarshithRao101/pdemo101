# .env.example — copy to .env and fill in. Never commit the real .env.
#
# The app refuses to start if JWT_SECRET is missing or shorter than 32
# characters. That is deliberate: a missing secret must stop the process, not
# silently fall back to a value anyone could read in the source.

# --- Database (required) ---
MONGODB_URI=
MONGODB_DB_NAME=jc_erp_prod

# --- Auth (JWT_SECRET required, 32+ chars) ---
JWT_SECRET=
JWT_EXPIRES_IN=1h

# --- Sign-in lockout (optional; defaults shown) ---
# MAX_LOGIN_ATTEMPTS is per account, or per campus+address for a clerk signing
# in without a username. MAX_CAMPUS_LOGIN_ATTEMPTS is the wider backstop that
# bounds an attacker rotating addresses against one campus — it must stay well
# above what a shift of clerks produces by mistyping, or a busy morning locks
# a campus out of its own portal.
# MAX_LOGIN_ATTEMPTS=5
# MAX_CAMPUS_LOGIN_ATTEMPTS=50
# LOCKOUT_MINUTES=15

# --- CORS (required in production) ---
# Comma-separated, exact origins including scheme. No wildcards, no partial
# matches. Localhost is auto-allowed only when NODE_ENV is not "production".
ALLOWED_ORIGINS=https://inspirehnk.org,https://www.inspirehnk.org

# --- Google Drive backups (required for backup/restore to work) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# --- Backup encryption (required; 32+ random chars) ---
# Store this separately from the backups themselves. Losing it makes every
# existing backup permanently unreadable.
BACKUP_ENCRYPTION_KEY=

# --- Operations password (required for wipe, purge and restore) ---
#
# A BCRYPT HASH, never the password itself. The three destructive routes ask
# for this on top of the caller's own session and PIN.
#
# Absent, those routes answer 503 and refuse — a missing secret never means
# "no check required". That is safe, but the cause is not obvious from the
# outside, which is exactly what happened: this variable was live on the
# server and missing from this file, so a deployment built from the template
# had wipe, purge and restore quietly unavailable with nothing to explain it.
#
# Generate it with the password passed in the environment, NOT typed on the
# command line where it lands in shell history:
#
#   node -e "console.log(require('bcryptjs').hashSync(process.env.P, 12))"
#
OPS_PASSWORD_HASH=

# --- Optional tuning (sensible defaults if unset) ---
# MAX_LOGIN_ATTEMPTS            — wrong guesses before lockout (default 5)
# LOCKOUT_MINUTES               — how long a lockout lasts (default 15)
# SESSION_IDLE_TIMEOUT_MINUTES  — idle before sign-out (default 180)
# TRUSTED_PROXY_HOPS            — proxies in front of the app (default 1)

# NOTE: there is deliberately no JWT_REFRESH_SECRET here. Refresh tokens are
# not JWTs — they are 40 random bytes, stored as a SHA-256 hash and rotated on
# use — so nothing signs them and no such secret exists. One was set on the
# live server and read by no code at all, which invites rotating a value that
# does nothing and believing something was done.

# --- Set by the host, not by you ---
# PORT       — Hostinger assigns this
# NODE_ENV   — set to "production" on the live host
